# Desktop 原生应用环境（由 scripts/desktop-run-backend.sh 加载）
# DATABASE_URL / STORAGE_ROOT 由启动脚本按用户数据目录自动设置（SQLite）
DESKTOP_MODE=true
DEBUG=false
APP_NAME=Huoke
FRONTEND_ORIGIN=http://127.0.0.1:18765

# 云端客户后台（盈小蚁 H5）嵌入
VITE_PORTAL_ENABLED=1
VITE_PORTAL_BASE_URL=https://www.tanjiyunai.com

DOUYIN_HEADLESS=false
XHS_HEADLESS=false
KUAISHOU_HEADLESS=false

ANTIBOT_BROWSER_CHANNEL=chrome
ANTIBOT_PLAYWRIGHT_FALLBACK=false
ANTIBOT_FINGERPRINT_PLATFORM=mac
ANTIBOT_PERSISTENT_PROFILE=true
ANTIBOT_WARMUP_ENABLED=true

AGENT_HEADLESS=false
AGENT_VISION_ENABLED=true
AGENT_DEFAULT_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
