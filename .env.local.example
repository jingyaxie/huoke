# 本地 Mac 开发（宿主机后端 + 系统 Chrome + SQLite）
# 复制为 .env.local 后按需修改
# 启动: bash scripts/dev-native.sh

APP_NAME=Huoke
DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173

DOUYIN_HOME_URL=https://www.douyin.com
DOUYIN_HOT_URL=https://www.douyin.com/hot
DOUYIN_HEADLESS=false

XHS_HOME_URL=https://www.xiaohongshu.com
XHS_EXPLORE_URL=https://www.xiaohongshu.com/explore
XHS_HEADLESS=false

KUAISHOU_HOME_URL=https://www.kuaishou.com
KUAISHOU_HEADLESS=false

# 使用本机 Google Chrome，不回退 Playwright 内置 Chromium
ANTIBOT_BROWSER_CHANNEL=chrome
ANTIBOT_PLAYWRIGHT_FALLBACK=false
ANTIBOT_FINGERPRINT_PLATFORM=mac
ANTIBOT_PERSISTENT_PROFILE=true
ANTIBOT_WARMUP_ENABLED=true

AGENT_HEADLESS=false
AGENT_VISION_ENABLED=true
AGENT_DEFAULT_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
